# ── Required ────────────────────────────────────────────────────────────────
# Your Clash Royale API key from https://developer.clashroyale.com
# IMPORTANT: whitelist the IP of the server that runs this proxy for that key.
CLASH_ROYALE_API_TOKEN=""

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=3002
# HOST=0.0.0.0

# ── Upstream ────────────────────────────────────────────────────────────────
# Override the upstream base URL (defaults to the official Clash Royale API).
# UPSTREAM_BASE_URL=https://api.clashroyale.com/v1
# Hard timeout for upstream requests, in milliseconds.
# UPSTREAM_TIMEOUT_MS=10000

# ── Abuse protection (protects your key's rate quota) ───────────────────────
# Per-IP rate limit: max requests per window.
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000
# Response cache TTL in milliseconds (0 disables caching).
# CACHE_TTL_MS=30000
# CACHE_MAX_ENTRIES=500
# Set to true ONLY when running behind a trusted reverse proxy that sets
# X-Forwarded-For; otherwise clients could spoof their rate-limit identity.
# TRUST_PROXY=false

# ── Access control ──────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins, or * for any origin (default).
# CORS_ORIGIN=*
# Uncomment to require a bearer token on /api/* (private deployments):
# PROXY_AUTH_TOKEN=""
