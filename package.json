{
  "name": "royale-proxy-api",
  "version": "2.0.0",
  "description": "A lean, secure proxy for the official Clash Royale API — no client IP whitelisting required.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@varandas/clash-royale-api": "^2.3.1",
    "hono": "^4.13.19",
    "hono-rate-limiter": "^0.5.4",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
